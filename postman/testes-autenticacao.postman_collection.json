{
  "info": {
    "_postman_id": "0b3b5b19-f836-42ae-95e8-4aa8b6971acb",
    "name": "Testes de Autenticação",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Cinco cenários de autenticação Supabase. Configurar base_url, api_key (anon legada), email e password no ambiente local. Credenciais não acompanham a entrega."
  },
  "item": [
    {
      "name": "CT01 - Login válido",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "apikey",
            "value": "{{api_key}}"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{api_key}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/auth/v1/token?grant_type=password",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "v1",
            "token"
          ],
          "query": [
            {
              "key": "grant_type",
              "value": "password"
            }
          ]
        },
        "description": "Requisição executada manualmente pelo aluno em 07/11/2026. Resultado documentado no README e na planilha; evidência real na pasta prints."
      },
      "response": []
    },
